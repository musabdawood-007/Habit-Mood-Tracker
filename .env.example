# ===========================================
# Habit & Mood Tracker — Environment Variables
# ===========================================
# Copy this file to `.env.local` and fill in real values.
# All values below are PLACEHOLDERS — none will work as-is.

# ---------- Database ----------
# MongoDB connection string from MongoDB Atlas (free M0 tier works fine).
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/habit-mood-tracker?retryWrites=true&w=majority

# ---------- Auth ----------
# NextAuth.js — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace_with_64_char_random_string
# Used by NextAuth for callbacks. In dev: http://localhost:3000 — in prod: your Vercel URL
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Create OAuth 2.0 Client ID → Authorized redirect URI must be:
#   http://localhost:3000/api/auth/callback/google   (dev)
#   https://YOUR-DOMAIN/api/auth/callback/google      (prod)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ---------- SMTP (for OTP emails) ----------
# See README for how to get an App Password from Gmail / Outlook / etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASS=abcd efgh ijkl mnop
SMTP_FROM=your.email@gmail.com
SMTP_FROM_NAME=Habit & Mood Tracker

# ---------- AI Insights (Milestone C) ----------
# Tested with bynara.id router (OpenAI-compatible endpoint).
# Working model on our plan: tencent-hy3 (free, 5-25s latency).
# Other providers work too — just change AI_API_BASE + AI_MODEL.
AI_API_BASE=https://router.bynara.id/v1
AI_API_KEY=your_api_key_here
AI_MODEL=tencent-hy3

# ---------- Web Push (Milestone C stretch) ----------
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=public_key_here
VAPID_PRIVATE_KEY=private_key_here
VAPID_SUBJECT=mailto:your@email.com

# ---------- App ----------
APP_NAME=Habit & Mood Tracker
APP_URL=http://localhost:3000
